# Postgres
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_dev_password
POSTGRES_DB=nexus
DATABASE_URL=postgresql://nexus:nexus_dev_password@localhost:5432/nexus

# Redis
REDIS_URL=redis://localhost:6379/0

# Cloud LLM fallback (free tier) - leave blank until you create a key
GROQ_API_KEY=

# Web search tool (Level 0 - automatic). Free tier at tavily.com
TAVILY_API_KEY=

# Optional acceleration provider - disabled by default per zero-cost principle
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_ENABLED=false

# Backend
BACKEND_PORT=8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
